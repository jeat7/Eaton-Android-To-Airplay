<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/overview_fragment">

    <fragment
        android:id="@+id/overview_fragment"
        android:name="io.github.jqssun.displaymirror.OverviewFragment"
        android:label="@string/overview">
        <action android:id="@+id/action_overview_to_sunshine" app:destination="@id/sunshine_fragment" />
        <action android:id="@+id/action_overview_to_airplay" app:destination="@id/airplay_fragment" />
        <action android:id="@+id/action_overview_to_displaylink" app:destination="@id/displaylink_fragment" />
    </fragment>

    <fragment android:id="@+id/connect_fragment" android:name="io.github.jqssun.displaymirror.ConnectFragment" android:label="@string/airlink_connect_nav"/>
    <fragment android:id="@+id/tools_fragment" android:name="io.github.jqssun.displaymirror.AirLinkToolsFragment" android:label="@string/airlink_tools"/>
<fragment android:id="@+id/remote_fragment" android:name="io.github.jqssun.displaymirror.AirLinkRemoteFragment" android:label="@string/airlink_remote"/>
<fragment android:id="@+id/profiles_fragment" android:name="io.github.jqssun.displaymirror.AirLinkProfilesFragment" android:label="@string/airlink_profiles"/>
<fragment android:id="@+id/session_fragment" android:name="io.github.jqssun.displaymirror.AirLinkSessionFragment" android:label="@string/airlink_session"/>
<fragment android:id="@+id/picture_fragment" android:name="io.github.jqssun.displaymirror.AirLinkPictureFragment" android:label="@string/airlink_picture"/>
<fragment android:id="@+id/showcase_fragment" android:name="io.github.jqssun.displaymirror.AirLinkShowcaseFragment" android:label="@string/airlink_showcase"/>
<fragment android:id="@+id/health_fragment" android:name="io.github.jqssun.displaymirror.AirLinkHealthFragment" android:label="@string/airlink_health"/>
<fragment android:id="@+id/diagnostics_fragment" android:name="io.github.jqssun.displaymirror.AirLinkDiagnosticsFragment" android:label="@string/airlink_diagnostics"/>
<fragment android:id="@+id/receivers_fragment" android:name="io.github.jqssun.displaymirror.AirLinkReceiversFragment" android:label="@string/airlink_receivers"/> 
<fragment android:id="@+id/help_fragment" android:name="io.github.jqssun.displaymirror.HelpFragment" android:label="@string/airlink_help_nav"/>
    <fragment
        android:id="@+id/sunshine_fragment"
        android:name="io.github.jqssun.displaymirror.sunshine.SunshineFragment"
        android:label="@string/tab_sunshine" />

    <fragment
        android:id="@+id/displaylink_fragment"
        android:name="io.github.jqssun.displaymirror.displaylink.DisplaylinkFragment"
        android:label="@string/tab_displaylink" />

    <fragment
        android:id="@+id/airplay_fragment"
        android:name="io.github.jqssun.displaymirror.airplay.AirPlayFragment"
        android:label="@string/tab_airplay" />

    <fragment
        android:id="@+id/logs_fragment"
        android:name="io.github.jqssun.displaymirror.LogsFragment"
        android:label="@string/tab_logs" />

    <fragment
        android:id="@+id/settings_fragment"
        android:name="io.github.jqssun.displaymirror.SettingsFragment"
        android:label="@string/tab_settings" />

</navigation>
